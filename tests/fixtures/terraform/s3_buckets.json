{
    "resource": {
        "aws_s3_bucket": {
            "insecure_bucket": {
                "bucket": "company-sensitive-data",
                "region": "eu-west-2",
                "public": true,
                "encryption": false,
                "versioning": false,
                "logging": false,
                "block_public_access": false
            },
            "secure_bucket": {
                "bucket": "company-secure-data",
                "region": "eu-west-2",
                "public": false,
                "encryption": true,
                "versioning": true,
                "logging": true,
                "block_public_access": true
            }
        },
        "aws_s3_bucket_policy": {
            "secure_bucket_policy": {
                "bucket": "${aws_s3_bucket.secure_bucket.id}",
                "policy": {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Deny",
                            "Principal": "*",
                            "Action": "s3:*",
                            "Resource": [
                                "arn:aws:s3:::company-secure-data",
                                "arn:aws:s3:::company-secure-data/*"
                            ],
                            "Condition": {
                                "Bool": {
                                    "aws:SecureTransport": "false"
                                }
                            }
                        }
                    ]
                }
            }
        }
    }
}