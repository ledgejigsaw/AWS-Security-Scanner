{
    "resource": {
        "aws_s3_bucket": {
            "company_data": {
                "bucket": "company-sensitive-data",
                "region": "eu-west-2"
            },
            "company_secure_data": {
                "bucket": "company-secure-data",
                "region": "eu-west-2"
            }
        },
        "aws_s3_bucket_versioning": {
            "company_data": {
                "bucket": "${aws_s3_bucket.company_data.id}",
                "versioning_configuration": {
                    "status": "Disabled"
                }
            },
            "company_secure_data": {
                "bucket": "${aws_s3_bucket.company_secure_data.id}",
                "versioning_configuration": {
                    "status": "Enabled"
                }
            }
        },
        "aws_s3_bucket_server_side_encryption_configuration": {
            "company_data": {
                "bucket": "${aws_s3_bucket.company_data.id}",
                "rule": {
                    "apply_server_side_encryption_by_default": {
                        "sse_algorithm": "AES256"
                    }
                }
            },
            "company_secure_data": {
                "bucket": "${aws_s3_bucket.company_secure_data.id}",
                "rule": {
                    "apply_server_side_encryption_by_default": {
                        "sse_algorithm": "AES256"
                    }
                }
            }
        },
        "aws_s3_bucket_public_access_block": {
            "company_data": {
                "bucket": "${aws_s3_bucket.company_data.id}",
                "block_public_acls": false,
                "block_public_policy": false,
                "ignore_public_acls": false,
                "restrict_public_buckets": false
            },
            "company_secure_data": {
                "bucket": "${aws_s3_bucket.company_secure_data.id}",
                "block_public_acls": true,
                "block_public_policy": true,
                "ignore_public_acls": true,
                "restrict_public_buckets": true
            }
        },
        "aws_s3_bucket_logging": {
            "company_data": {
                "bucket": "${aws_s3_bucket.company_data.id}",
                "target_bucket": ""
            },
            "company_secure_data": {
                "bucket": "${aws_s3_bucket.company_secure_data.id}",
                "target_bucket": "company-access-logs"
            }
        },
                "aws_s3_bucket_policy": {
            "company_data": {
                "bucket": "${aws_s3_bucket.company_data.id}",
                "policy": {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": "*",
                            "Action": "s3:GetObject",
                            "Resource": "*"
                        }
                    ]
                }
            },
            "company_secure_data": {
                "bucket": "${aws_s3_bucket.company_secure_data.id}",
                "policy": {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "AWS": "arn:aws:iam::123456789012:role/ApplicationRole"
                            },
                            "Action": "s3:GetObject",
                            "Resource": "*"
                        }
                    ]
                }
            }
        }
    }
}