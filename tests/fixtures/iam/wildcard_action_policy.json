{
    "resource_type": "aws_iam_policy",
    "policy_name": "S3WildcardActionPolicy",
    "policy_type": "customer_managed",
    "policy_document": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Effect": "Allow",
                "Action": "s3:*",
                "Resource": "arn:aws:s3:::company-data/*"
            }
        ]
    }
}