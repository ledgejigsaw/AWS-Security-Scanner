{
    "policy_name": "RestrictedS3Policy",
    "policy_type": "customer_managed",
    "policy_document": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject"
                ],
                "Resource": "arn:aws:s3:::company-secure-data/*"
            }
        ]
    }
}